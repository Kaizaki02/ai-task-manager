# Copy to .env and fill in. Never commit the real .env file.

# Used to sign login tokens. Set a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional: enables the LLM-powered summary. Without it the app uses built-in rules.
# Get a FREE key at https://console.groq.com/keys
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: any SQLAlchemy URL, e.g. a PostgreSQL database. Defaults to a local SQLite file.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/tasks
